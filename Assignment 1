# Marking Tasks and Habits as Complete
import datetime

def mark_task_complete():
    # First, collect every task that isn't done yet, along with its day
    incomplete = []
    for day, day_tasks in tasks.items():
        for task, done in day_tasks.items():
            if not done:
                incomplete.append((task, day))

    # Nothing left to do, so we can stop here
    if not incomplete:
        print("All tasks completed!")
        return

    print("\nTasks still to do:")
    for task, day in incomplete:
        print(f"  - {task} ({day})")

    name = input("\nWhich task did you finish? ").strip()

    # Look through every day for a task with that name
    found = False
    for day, day_tasks in tasks.items():
        for task, done in day_tasks.items():
            # Ignore capital letters so "pay bills" matches "Pay bills"
            if task.lower() == name.lower() and not done:
                tasks[day][task] = True
                found = True

                # BONUS: compare the task's day to today's day
                # (a smaller position in the list means an earlier day)
                today = datetime.datetime.now().strftime("%A")
                if days.index(day) < days.index(today):
                    print(f"'{task}' marked as complete. Better late than never!")
                else:
                    print(f"'{task}' marked as complete. Great job!")
                break
        if found:
            break

    if not found:
        print(f"Hmm, I couldn't find a task called '{name}' in your to-do list. "
              "Check the spelling and try again.")


def mark_habit_complete():
    day = input("Which day did you do it? ").strip().title()
    if day not in days:
        print(f"Sorry, '{day}' isn't a valid day. Try one of: {', '.join(days)}.")
        return

    name = input("Which habit? ").strip().title()
    if name not in habits:
        print(f"You aren't tracking a habit called '{name}'. Add it first with add_habit().")
        return

    habits[name][day] = True
    print(f"'{name}' marked as done for {day}. Keep it up!")


