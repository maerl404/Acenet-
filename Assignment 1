# Part 1 
# All the days of the week, in order
days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']

# Habits start out empty. Each habit will get its own dictionary of days later,
# like {'Drink Water': {'Monday': False, 'Tuesday': False, ...}}
habits = {}

# Every day gets its own empty dictionary to hold that day's tasks,
# like {'Monday': {'Pay bills': False}, 'Tuesday': {}, ...}
tasks = {day: {} for day in days}


# Add Tasks and Habits
def add_task():
    # Ask which day the task belongs to and clean up the typing
    # (so "  monDAY " still works)
    day = input("Which day do you want to add the task to? ").strip().title()

    # Stop right away if that isn't a real day
    if day not in days:
        print(f"Sorry, '{day}' isn't a valid day. Try one of: {', '.join(days)}.")
        return

    task = input("What's the task? ").strip()

    # No point saving a blank task
    if task == "":
        print("The task name can't be empty.")
        return

    # Don't add the same task twice on the same day
    if task in tasks[day]:
        print(f"'{task}' is already on your list for {day}.")
        return

    # False means it's not done yet
    tasks[day][task] = False
    print(f"Got it! '{task}' has been added to {day}.")


def add_habit():
    habit = input("What habit do you want to track (e.g., Drink Water)? ").strip().title()

    if habit == "":
        print("The habit name can't be empty.")
        return

    # Let the user know if they're already tracking this one
    if habit in habits:
        print(f"You're already tracking '{habit}'.")
        return

    # A habit repeats every day, so give it all 7 days, all not done yet
    habits[habit] = {day: False for day in days}
    print(f"Nice! '{habit}' is now being tracked for the whole week.")


