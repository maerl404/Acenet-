#Part 2
# Removing Tasks and Habits

def remove_task():
    day = input("Which day is the task on? ").strip().title()

    # Make sure it's a real day before touching anything
    if day not in days:
        print(f"Sorry, '{day}' isn't a valid day. Try one of: {', '.join(days)}.")
        return

    # An empty dictionary counts as False so this catches a day with no tasks
    if not tasks[day]:
        print(f"You don't have any tasks on {day}.")
        return

    print(f"\nTasks for {day}:")
    for task in tasks[day]:
        print(f"  - {task}")

    name = input("\nWhich task do you want to remove? ").strip()

    # Tasks are saved exactly how they were typed, so match them
    # ignoring capital letters instead of forcing .title()
    for task in tasks[day]:
        if task.lower() == name.lower():
            del tasks[day][task]
            print(f"Done! '{task}' was removed from {day}.")
            return

    print(f"Hmm, '{name}' isn't on your {day} list. Check the spelling and try again.")


def remove_habit():
    # Nothing to remove if there are no habits
    if not habits:
        print("You aren't tracking any habits yet.")
        return

    print("\nHabits you're tracking:")
    for habit in habits:
        print(f"  - {habit}")

    name = input("\nWhich habit do you want to remove? ").strip().title()

    if name not in habits:
        print(f"Hmm, you aren't tracking a habit called '{name}'. Check the spelling and try again.")
        return

    del habits[name]
    print(f"Done! The habit '{name}' was removed.")


