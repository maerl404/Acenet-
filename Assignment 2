# Generating Weekly and Daily Reports

def weekly_report():
    print("\n===== WEEKLY REPORT =====")

    #Habits
    print("\nHabits:")
    if not habits:
        print("  You aren't tracking any habits yet.")
    else:
        for habit, habit_days in habits.items():
            # Add 1 for every day that is marked True
            days_done = sum(1 for done in habit_days.values() if done)
            print(f"  {habit}: {days_done}/7 days complete")

    #Tasks
    completed = []
    not_completed = []
    for day, day_tasks in tasks.items():
        for task, done in day_tasks.items():
            if done:
                completed.append(f"{task} ({day})")
            else:
                not_completed.append(f"{task} ({day})")

    print("\nTasks:")
    if not completed and not not_completed:
        print("  You don't have any tasks yet.")
    else:
        print("  ✅ Completed:")
        if completed:
            for item in completed:
                print(f"     - {item}")
        else:
            print("     (none yet)")

        print("  ❌ Not completed:")
        if not_completed:
            for item in not_completed:
                print(f"     - {item}")
        else:
            print("     (none, nice work!)")

    print("\n=========================")


def daily_report():
    day = input("Which day do you want a report for? ").strip().title()

    if day not in days:
        print(f"Sorry, '{day}' isn't a valid day. Try one of: {', '.join(days)}.")
        return

    print(f"\n===== REPORT FOR {day.upper()} =====")

    #Tasks for that day
    print("\nTasks:")
    if not tasks[day]:
        print("  No tasks for this day.")
    else:
        for task, done in tasks[day].items():
            symbol = "✅" if done else "❌"
            print(f"  {symbol} {task}")

    #Habits on that day 
    print("\nHabits:")
    if not habits:
        print("  You aren't tracking any habits yet.")
    else:
        for habit, habit_days in habits.items():
            symbol = "✅" if habit_days[day] else "❌"
            print(f"  {symbol} {habit}")

    print("\n=============================")


